# Python
__pycache__/
*.py[cod]
*.egg-info/

# OS
.DS_Store

# Environments
cactus_env/
venv/
.venv/

# Vendored encoder (~90MB, regenerate with scripts/setup_login_node.sh)
models/embedding/

# HuggingFace cache, if pointed at a project-local dir
hf_cache/

# Training artifacts (large / regenerable). results/*.json stays tracked:
# it is the evidence behind the paper's numbers.
logs/checkpoints/*.zip
logs/ppo_tensorboard/

# ...but the SLURM logs of the runs that produced the reported numbers ARE
# tracked, so every number in the paper is traceable to a job that ran.
# These are named in FROZEN_RESULTS.md; without the negations below the
# `logs/*.out` rule above would silently exclude the paper's own provenance.
!logs/final_run/
!logs/multimodel_58724.out
!logs/multimodel_58724.err
!logs/scale70b_58915.out
!logs/scale70b_58915.err
!logs/alphashift_59061.out
!logs/alphashift_59061.err
!logs/nlshift_59325.out
!logs/nlshift_59325.err
!logs/bank61_65126.out
!logs/bank61_65126.err
!logs/bank61_70b_65133.out
!logs/bank61_70b_65133.err
!logs/bank61_70b_topup_65215.out
!logs/bank61_70b_topup_65215.err
!logs/nativestop_67879.out
!logs/nativestop_67879.err
!logs/basevsinst_67978.out
!logs/basevsinst_67978.err
# 67880 is a FAILED run and is tracked deliberately: the paper's protocol
# section cites its batch-invariance residual of 1.35e-01 on cn3_anandi as the
# reason the experiment is pinned to mangala. The claim needs its evidence.
!logs/basevsinst_67880.out
!logs/basevsinst_67880.err

# SLURM writes to the directory you submit FROM, so submitting inside scripts/
# produces a second copy of every log. Same filenames as logs/, no extra
# information; `logs/*.out` is anchored at the repo root and does not catch them.
scripts/logs/

# Merge leftovers retired by scripts/merge_topup.py (content already folded in)
*.merged

# The manuscript and design notes are kept LOCAL and deliberately not
# published to GitHub. They were tracked until now, so ignoring them is not
# enough on its own -- they were untracked with:
#     git rm -r --cached paper docs
# which leaves every file in place on disk. Note that git does not descend
# into an excluded directory, so a negation such as !paper/figures/*.pdf
# would NOT work below; do not add one expecting it to.
#
# This does not remove the manuscript from the repository's HISTORY, where it
# remains readable in earlier commits. Removing it from history needs a
# filter-repo rewrite and a force push, which was considered and declined.
paper/
docs/

# Overleaf upload package (build artifact; regenerate any time)
termination_paper_overleaf.zip
RESEARCH_PLAN.md
